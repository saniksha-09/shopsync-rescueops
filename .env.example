# Google Gemini AI Studio API Key (Free tier available at: https://aistudio.google.com/app/apikey)
# Note: If left empty, ShopSync RescueOps automatically runs in Smart Fallback Mode so the app never fails!
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model (Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
NEXT_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# Port configuration (Defaults to 3000)
PORT=3000
